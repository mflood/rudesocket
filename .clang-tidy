# Checks chosen to be meaningful on this codebase rather than aspirational.
#
# The broad modernize-*/readability-* families would flag thousands of lines of
# 2005-era style with no correctness benefit, and a gate nobody can keep green
# gets ignored or disabled. This set targets bugs, and the source is clean
# against it, so CI can treat any new finding as an error.
#
# Each exclusion below was reviewed against the actual findings, not guessed:
#
#   misc-include-cleaner
#       Wants every used symbol included directly. This codebase uses the
#       "#ifndef INCLUDED_X" idiom with deliberate transitive includes; 44
#       findings, none of them defects.
#
#   misc-const-correctness
#       42 findings, all local variables that could be const. Style, not
#       correctness, and the churn would bury real changes in review.
#
#   bugprone-branch-clone
#       1 finding, reviewed and intentional.
#
#   cert-err34-c
#       1 finding, atoi() on a port number already validated by the caller.
#
#   cert-err33-c
#       8 findings, all snprintf() into a buffer explicitly sized for the
#       message. Truncation is not reachable.
#
#   bugprone-easily-swappable-parameters, bugprone-narrowing-conversions,
#   misc-no-recursion, misc-non-private-member-variables-in-classes,
#   misc-use-anonymous-namespace, performance-avoid-endl
#       Design-opinion checks that would require reshaping the public API.
---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-err33-c,
  -cert-err34-c,
  -cert-err58-cpp,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -performance-avoid-endl

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/src/.*'
FormatStyle: file
